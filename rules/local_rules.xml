<!--
  Custom Wazuh rules for the wazuh-soc-lab.
  Copy into /var/ossec/etc/rules/local_rules.xml on the Wazuh manager, then restart the manager.
  Custom rule IDs must be between 100000 and 120000.
-->

<group name="local,sshd,authentication_failures,">

  <!-- 8+ failed SSH logins from the same source IP within 120 seconds -->
  <rule id="100100" level="10" frequency="8" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force: $(srcip) failed 8+ logins in 2 minutes</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,</group>
  </rule>

  <!-- Successful login from an IP that just triggered the brute-force rule -->
  <rule id="100101" level="13" frequency="1" timeframe="300">
    <if_sid>5715</if_sid>
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Possible compromise: successful SSH login from $(srcip) after brute force</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

</group>

<group name="local,windows,account_changes,">

  <!-- Windows Security 4720: a user account was created -->
  <rule id="100110" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4720$</field>
    <description>New local account created: $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <!-- Windows Security 4732: member added to the local Administrators group -->
  <rule id="100111" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4732$</field>
    <field name="win.eventdata.targetUserName">^Administrators$</field>
    <description>Account added to local Administrators group by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

</group>

<group name="local,windows,powershell,">

  <!-- PowerShell 4104 script block containing download + execution or encoded commands -->
  <rule id="100120" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4104$</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(downloadstring|downloadfile|invoke-webrequest).*(iex|invoke-expression)|frombase64string|-encodedcommand</field>
    <description>Suspicious PowerShell script block (download cradle or encoded command)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

</group>
